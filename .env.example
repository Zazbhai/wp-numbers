# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/register_checker?retryWrites=true&w=majority
MONGODB_DB_NAME=register_checker

# Protects the business line admin API. Set a long random value on the server.
BUSINESS_LINES_ADMIN_KEY=

# 32-byte base64 key for encrypting BharatPe credentials stored in MongoDB.
# Generate with: openssl rand -base64 32
PAYMENT_CONFIG_ENCRYPTION_KEY=

# Local testing only: false (or 0) bypasses payment and allows signed-in test allocations.
# Restart the dev server after changing this value. Use true in production.
PAYMENT_SYSTEM_ENABLED=false

# Telegram Bot API token (from @BotFather)
TELEGRAM_API_KEY=

# SMS API key (optional)
FURYSMS_API_KEY=

# Monitor settings
WA_SLOT=1
WA_DATA=
WA_APP_ORIGIN=http://localhost:8080
WA_PROXIES=proxies.txt

# Ports Configuration
# Port for main app & checker (default: 8080)
PORT=8080
# Port for Marketplace & API Docs user portal
MARKETPLACE_PORT=3000
# Port for Standalone Public SMS API server
API_PORT=5000
